  public static Command setMotorRpm(Shooter shooter, double rpm) {
    return Commands.sequence(
        Commands.run(() -> shooter.setMotorRpm(rpm), shooter)
            .until(() -> shooter.atTargetRPM(rpm)),
        Commands.run(
            () -> {
              shooter.setMotorRpm(rpm);
              shooter.runFeeder();
            },
            shooter));
  }



